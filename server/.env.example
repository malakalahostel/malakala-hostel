PORT=5000
NODE_ENV=production

# Gmail account that sends application emails (must match App Password account)
EMAIL_USER=malkalahostel1956@gmail.com
# 16-character Google App Password (NOT your normal Gmail password)
# Create at: https://myaccount.google.com/apppasswords  (2-Step Verification required)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Alternatively: Resend HTTP API Key (recommended if deployed on Render Free Tier to bypass blocked SMTP ports)
# Get a free key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Malkala Hostel <onboarding@resend.dev>

# Optional overrides (defaults work for Gmail on port 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

ADMIN_PASSWORD=change_me
DONOR_PASSWORD=change_me

# Supabase / Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
